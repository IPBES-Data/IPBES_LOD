        <http://ontology.ipbes.net/report/ref/2333077/items/RA8YHV3L>,
        <http://ontology.ipbes.net/report/ref/2333077/items/RFZJRDQD>,
        <http://ontology.ipbes.net/report/ref/2333077/items/RKTGC4UU>,
        <http://ontology.ipbes.net/report/ref/2333077/items/SH7EMCDY>,
        <http://ontology.ipbes.net/report/ref/2333077/items/T4RB6YJA>,
