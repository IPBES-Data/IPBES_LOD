        <http://ontology.ipbes.net/report/ref/2333077/items/NDQ5ELB7>,
        <http://ontology.ipbes.net/report/ref/2333077/items/QFKV6EMX>,
        <http://ontology.ipbes.net/report/ref/2333077/items/QSCE254L>,
        <http://ontology.ipbes.net/report/ref/2333077/items/UVGVXQQE>,
        <http://ontology.ipbes.net/report/ref/2333077/items/VREDQ8HN>,
