        <http://ontology.ipbes.net/report/ref/2333077/items/8LIUU4E5>,
        <http://ontology.ipbes.net/report/ref/2333077/items/BKMQQKA6>,
        <http://ontology.ipbes.net/report/ref/2333077/items/FBKDL7GC>,
        <http://ontology.ipbes.net/report/ref/2333077/items/GJQKUVMH>,
        <http://ontology.ipbes.net/report/ref/2333077/items/GQ253L6H>,
        <http://ontology.ipbes.net/report/ref/2333077/items/HZIJN25L>,
        <http://ontology.ipbes.net/report/ref/2333077/items/J4A9UEJC>,
        <http://ontology.ipbes.net/report/ref/2333077/items/MJGUESZ7>,
        <http://ontology.ipbes.net/report/ref/2333077/items/PH7B9AAI>,
        <http://ontology.ipbes.net/report/ref/2333077/items/TBGN8F8Y>,
        <http://ontology.ipbes.net/report/ref/2333077/items/UK3MMYAU>,
        <http://ontology.ipbes.net/report/ref/2333077/items/W4I4RZ72> ;
