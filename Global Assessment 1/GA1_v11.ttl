        <http://ontology.ipbes.net/report/ref/2333077/items/WKC6NDYH>,
        <http://ontology.ipbes.net/report/ref/2333077/items/WKX5F5ND>,
        <http://ontology.ipbes.net/report/ref/2333077/items/WMSCWTZC>,
        <http://ontology.ipbes.net/report/ref/2333077/items/Y28W4U6K>,
        <http://ontology.ipbes.net/report/ref/2333077/items/Z9AIG5JI>,
