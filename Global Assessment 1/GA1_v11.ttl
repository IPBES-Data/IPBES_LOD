        <http://ontology.ipbes.net/report/ref/2333077/items/8YGVNKVE>,
        <http://ontology.ipbes.net/report/ref/2333077/items/95QTI93B>,
        <http://ontology.ipbes.net/report/ref/2333077/items/9I3AMFP8>,
        <http://ontology.ipbes.net/report/ref/2333077/items/AAR2JRSD>,
        <http://ontology.ipbes.net/report/ref/2333077/items/DQTHIIVH>,
        <http://ontology.ipbes.net/report/ref/2333077/items/EUVFZACZ>,
        <http://ontology.ipbes.net/report/ref/2333077/items/G8BDD87T>,
        <http://ontology.ipbes.net/report/ref/2333077/items/HPXBL8PR>,
        <http://ontology.ipbes.net/report/ref/2333077/items/I92VVUWD>,
        <http://ontology.ipbes.net/report/ref/2333077/items/JU3YTSH3>,
