        <http://ontology.ipbes.net/report/ref/2333077/items/NJHIPZQ3>,
        <http://ontology.ipbes.net/report/ref/2333077/items/PLU493A2>,
        <http://ontology.ipbes.net/report/ref/2333077/items/T2EK65IF>,
        <http://ontology.ipbes.net/report/ref/2333077/items/T7N5FBN8>,
        <http://ontology.ipbes.net/report/ref/2333077/items/U2YN58IK>,
        <http://ontology.ipbes.net/report/ref/2333077/items/UVXPFRPH>,
        <http://ontology.ipbes.net/report/ref/2333077/items/W85NV82K>,
        <http://ontology.ipbes.net/report/ref/2333077/items/YDCUGVEV>,
