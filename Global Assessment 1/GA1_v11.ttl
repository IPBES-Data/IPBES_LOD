        <http://ontology.ipbes.net/report/ref/2333077/items/GR68LM9Y>,
        <http://ontology.ipbes.net/report/ref/2333077/items/IQBGFCTZ>,
        <http://ontology.ipbes.net/report/ref/2333077/items/KBXR28A5>,
        <http://ontology.ipbes.net/report/ref/2333077/items/LUKF5JU9>,
        <http://ontology.ipbes.net/report/ref/2333077/items/N3PKG225>,
