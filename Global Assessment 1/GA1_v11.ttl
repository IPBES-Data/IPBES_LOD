        <http://ontology.ipbes.net/report/ref/2333077/items/MDDESY8Z>,
        <http://ontology.ipbes.net/report/ref/2333077/items/QEN2JL36>,
        <http://ontology.ipbes.net/report/ref/2333077/items/QMUQZKYT>,
        <http://ontology.ipbes.net/report/ref/2333077/items/QRMMH2DP>,
        <http://ontology.ipbes.net/report/ref/2333077/items/S7TIPEFP>,
        <http://ontology.ipbes.net/report/ref/2333077/items/SKHSDLIJ>,
        <http://ontology.ipbes.net/report/ref/2333077/items/SRKAW2SM>,
        <http://ontology.ipbes.net/report/ref/2333077/items/VRYZF6TT>,
        <http://ontology.ipbes.net/report/ref/2333077/items/VZKUNVAB>,
