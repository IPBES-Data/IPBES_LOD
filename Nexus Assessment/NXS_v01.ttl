<http://ontology.ipbes.net/report/ref/4596166/items/XU46NKRJ> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/NXS24ch1>,
        <http://ontology.ipbes.net/report/ch/NXS24ch3>,
        <http://ontology.ipbes.net/report/ch/NXS24ch5.5>,
        <http://ontology.ipbes.net/report/ch/NXS24ch7> ;
    ipbes:Report <http://ontology.ipbes.net/report/NXS24> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/NXS24-1.1>,
        <http://ontology.ipbes.net/report/sch/NXS24-3.6>,
        <http://ontology.ipbes.net/report/sch/NXS24-5.5.1>,
        <http://ontology.ipbes.net/report/sch/NXS24-5.5.4>,
