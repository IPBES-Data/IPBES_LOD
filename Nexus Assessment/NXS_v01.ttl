    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.5.1, 4.5.3, Table 4.8, Box 4.12, 6.3.3.2" .

<http://ontology.ipbes.net/report/subm/NXS24-D5-SM9> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/NXS24-FigureSPM.11> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/NXS24-4.5>,
        <http://ontology.ipbes.net/report/sch/NXS24-7.5>,
        <http://ontology.ipbes.net/report/sch/NXS24-Table4.12> ;
    ipbes:hasDescription "and social networking capacities for facilitating co-learning opportunities by using knowledge and innovation brokers (Figure SPM.11) (established but incomplete) {4.5.5, Table 4.12, 7.5.5}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
